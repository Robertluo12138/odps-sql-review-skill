#!/usr/bin/env python3
"""bin/odps-sql-review

Convenience launcher so users can run ``./bin/odps-sql-review query.sql``
directly from a checkout without installing the package.  All real
logic lives in ``odps_sql_review.cli``.
"""

from __future__ import annotations

import os
import sys

_BIN_DIR = os.path.dirname(os.path.abspath(__file__))
_REPO_ROOT = os.path.dirname(_BIN_DIR)
if _REPO_ROOT not in sys.path:
    sys.path.insert(0, _REPO_ROOT)

from odps_sql_review.cli import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
